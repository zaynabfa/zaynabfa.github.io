<div class="education">
  {% if page.education %}
    {% for edu in page.education %}
      <div class="education-item">
        <div class="row">
          <div class="col-md-3">
            <span class="badge badge-primary">{{ edu.period }}</span>
          </div>
          <div class="col-md-9">
            <h4>{{ edu.degree }}</h4>
            <h5>{{ edu.institution }}</h5>
            {% if edu.location %}
              <p class="text-muted">{{ edu.location }}</p>
            {% endif %}
            {% if edu.description %}
              <p>{{ edu.description }}</p>
            {% endif %}
            {% if edu.gpa %}
              <p><strong>GPA:</strong> {{ edu.gpa }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>
